object ReportForm: TReportForm
  Left = 10
  Height = 320
  Top = 10
  Width = 480
  AutoSize = True
  BorderStyle = bsDialog
  Caption = 'Report a problem'
  ClientHeight = 320
  ClientWidth = 480
  Constraints.MinWidth = 480
  OnCreate = FormCreate
  Position = poOwnerFormCenter
  object PromptLabel: TLabel
    Left = 16
    Height = 17
    Top = 16
    Width = 448
    Align = alTop
    BorderSpacing.Left = 16
    BorderSpacing.Top = 16
    BorderSpacing.Right = 16
    Caption = 'What went wrong, or what looked wrong? What were you doing?'
    FocusControl = Words
    WordWrap = True
  end
  object Words: TMemo
    Left = 16
    Height = 160
    Top = 41
    Width = 448
    Align = alTop
    BorderSpacing.Left = 16
    BorderSpacing.Top = 8
    BorderSpacing.Right = 16
    MaxLength = 4000
    ScrollBars = ssAutoVertical
    TabOrder = 0
  end
  object HintLabel: TLabel
    Left = 16
    Height = 17
    Top = 209
    Width = 448
    Align = alTop
    BorderSpacing.Left = 16
    BorderSpacing.Top = 8
    BorderSpacing.Right = 16
    Caption = 'Sent along: your name, the server, the channel you are in, this program''s widgetset and system, and your window size. Nothing else.'
    Font.Color = clGrayText
    ParentFont = False
    WordWrap = True
  end
  object ButtonPanel1: TButtonPanel
    Left = 16
    Height = 36
    Top = 242
    Width = 448
    Align = alTop
    BorderSpacing.Left = 16
    BorderSpacing.Top = 16
    BorderSpacing.Right = 16
    BorderSpacing.Bottom = 16
    OKButton.OnClick = OKButtonClick
    ShowButtons = [pbOK, pbCancel]
    ShowGlyphs = []
    TabOrder = 1
  end
  object NoticeBar: TInfoBar
  end

end
