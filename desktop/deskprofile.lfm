object ProfileForm: TProfileForm
  Left = 10
  Height = 570
  Top = 10
  Width = 540
  BorderIcons = [biSystemMenu]
  BorderStyle = bsSizeable
  Caption = 'Profile'
  ClientHeight = 570
  ClientWidth = 540
  KeyPreview = True
  OnKeyDown = FormKeyDown
  OnShow = FormShow
  Position = poOwnerFormCenter
  object Body: TScrollBox
    Left = 0
    Top = 0
    Width = 540
    Height = 520
    Align = alClient
    BorderStyle = bsNone
    TabOrder = 0
    object Content: TPanel
      Left = 0
      Top = 0
      Width = 540
      Height = 520
      Align = alTop
      BevelOuter = bvNone
      Constraints.MinWidth = 540
      Constraints.MinHeight = 520
      TabOrder = 0
      object Avatar: TImage
        Left = 16
        Height = 80
        Top = 16
        Width = 80
        Center = True
        Proportional = True
        Stretch = True
      end
      object NameLabel: TLabel
        Left = 112
        Height = 25
        Top = 16
        Width = 412
        AutoSize = False
        Font.Height = -20
        Font.Style = [fsBold]
        ParentFont = False
      end
      object BadgeLabel: TLabel
        Left = 112
        Height = 20
        Top = 44
        Width = 412
        AutoSize = False
        Font.Style = [fsBold]
        ParentFont = False
      end
      object SeenLabel: TLabel
        Left = 112
        Height = 44
        Top = 68
        Width = 412
        AutoSize = False
        WordWrap = True
      end
      object AwayLabel: TLabel
        Left = 16
        Height = 64
        Top = 120
        Width = 508
        AutoSize = False
        WordWrap = True
      end
      object Details: TInkMemo
        Left = 16
        Height = 242
        Top = 192
        Width = 508
        Color = clWindow
        TabOrder = 0
        WordWrap = True
        OnLinkClick = DetailsLinkClick
        OnResource = DetailsResource
        Borders.Left = 8
        Borders.Top = 4
        Borders.Right = 8
        Borders.Bottom = 4
        StyleSheet.Strings = (
          'p { margin: 4px 0 }'
          '.codebar { display: none }'
          'img { max-width: 100%; max-height: 240px }'
        )
      end
      object Editor: TPanel
        Left = 16
        Height = 242
        Top = 192
        Width = 508
        BevelOuter = bvNone
        TabOrder = 1
        Visible = False
        object BioLabel: TLabel
          Left = 0
          Height = 20
          Top = 0
          Width = 508
          Caption = 'Bio (Markdown; up to 2000 characters):'
          FocusControl = BioEdit
        end
        object BioEdit: TMemo
          Left = 0
          Height = 126
          Top = 24
          Width = 508
          MaxLength = 2000
          ScrollBars = ssAutoVertical
          TabOrder = 0
        end
        object LinksLabel: TLabel
          Left = 0
          Height = 20
          Top = 158
          Width = 508
          Caption = 'Links (one per line; up to 500 characters):'
          FocusControl = LinksEdit
        end
        object LinksEdit: TMemo
          Left = 0
          Height = 60
          Top = 182
          Width = 508
          MaxLength = 500
          ScrollBars = ssAutoVertical
          TabOrder = 1
          WordWrap = False
        end
      end
      object Actions: TPanel
        Left = 16
        Height = 36
        Top = 446
        Width = 508
        BevelOuter = bvNone
        TabOrder = 2
        object EditButton: TButton
          Left = 0
          Height = 32
          Top = 0
          Width = 112
          Caption = 'Edit profile'
          OnClick = EditButtonClick
          TabOrder = 0
          Visible = False
        end
        object SaveButton: TButton
          Left = 0
          Height = 32
          Top = 0
          Width = 80
          Caption = 'Save'
          OnClick = SaveButtonClick
          TabOrder = 1
          Visible = False
        end
        object CancelEditButton: TButton
          Left = 88
          Height = 32
          Top = 0
          Width = 80
          Caption = 'Cancel edit'
          OnClick = CancelEditButtonClick
          TabOrder = 2
          Visible = False
        end
        object AvatarButton: TButton
          Left = 344
          Height = 32
          Top = 0
          Width = 164
          Caption = 'Change avatar...'
          Hint = 'Choose a picture for your profile'
          ShowHint = True
          OnClick = AvatarButtonClick
          TabOrder = 3
          Visible = False
        end
      end
      object StatusLabel: TLabel
        Left = 16
        Height = 32
        Top = 488
        Width = 508
        AutoSize = False
        WordWrap = True
      end
    end
  end
  object ButtonPanel1: TButtonPanel
    Left = 16
    Height = 34
    Top = 526
    Width = 508
    Align = alBottom
    BorderSpacing.Left = 16
    BorderSpacing.Right = 16
    BorderSpacing.Bottom = 10
    ShowButtons = [pbClose]
    ShowBevel = False
    ShowGlyphs = []
    TabOrder = 3
  end
  object AvatarDialog: TOpenDialog
    Title = 'Choose an avatar'
    Filter = 'Pictures|*.png;*.jpg;*.jpeg;*.gif;*.webp|All files|*'
    Options = [ofFileMustExist, ofEnableSizing]
    Left = 400
    Top = 24
  end
end
