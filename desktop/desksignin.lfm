    Top = 800
    Width = 372
    Align = alTop
    BorderSpacing.Left = 24
    BorderSpacing.Right = 24
    BorderSpacing.Bottom = 12
    PasswordChar = '*'
    TabOrder = 2
  end
  object JoinPanel: TPanel
    Left = 24
