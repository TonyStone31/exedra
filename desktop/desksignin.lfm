  OnDestroy = FormDestroy
  OnShow = FormShow
  Position = poScreenCenter
  object Logo: TImage
    Left = 24
    Height = 56
    Top = 100
    Width = 372
    Align = alTop
    BorderSpacing.Left = 24
    BorderSpacing.Top = 24
    BorderSpacing.Right = 24
    Center = True
    Proportional = True
    Stretch = True
  end
  object TitleLabel: TLabel
    Left = 24
    Height = 28
    Top = 200
    Width = 372
    Align = alTop
    Alignment = taCenter
    BorderSpacing.Left = 24
    BorderSpacing.Top = 8
    BorderSpacing.Right = 24
    Caption = 'Exedra'
    Font.Height = -22
    Font.Style = [fsBold]
