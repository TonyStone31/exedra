    BorderSpacing.Left = 24
    BorderSpacing.Right = 24
    BorderSpacing.Bottom = 12
    TabOrder = 0
    OnChange = ServerEditChange
    TextHint = 'https://chat.example.org'
  end
  object NameLabel: TLabel
    Left = 24
    Height = 17
    Top = 500
    Width = 372
    Align = alTop
    BorderSpacing.Left = 24
    BorderSpacing.Right = 24
