object RoomForm: TRoomForm
  Left = 10
  Height = 260
  Top = 10
  Width = 420
  AutoSize = True
  BorderIcons = [biSystemMenu]
  BorderStyle = bsDialog
  Caption = 'New channel'
  ClientHeight = 260
  ClientWidth = 420
  Constraints.MinWidth = 320
  Position = poMainFormCenter
  object NameLabel: TLabel
    Left = 16
    Height = 17
    Top = 16
    Width = 388
    Align = alTop
    BorderSpacing.Left = 16
    BorderSpacing.Top = 16
    BorderSpacing.Right = 16
    Caption = 'Channel name (letters, digits and hyphens)'
    FocusControl = NameEdit
    WordWrap = True
  end
  object NameEdit: TEdit
    Left = 16
    Height = 34
    Top = 37
    Width = 388
    Align = alTop
    BorderSpacing.Left = 16
    BorderSpacing.Top = 4
    BorderSpacing.Right = 16
    MaxLength = 40
    TabOrder = 0
    TextHint = 'my-project'
    OnChange = NameEditChange
  end
  object TopicLabel: TLabel
    Left = 16
    Height = 17
    Top = 87
    Width = 388
    Align = alTop
    BorderSpacing.Left = 16
    BorderSpacing.Top = 16
    BorderSpacing.Right = 16
    Caption = 'Topic (you can change it later)'
    FocusControl = TopicEdit
    WordWrap = True
  end
  object TopicEdit: TEdit
    Left = 16
    Height = 34
    Top = 108
    Width = 388
    Align = alTop
    BorderSpacing.Left = 16
    BorderSpacing.Top = 4
    BorderSpacing.Right = 16
    MaxLength = 500
    TabOrder = 1
    TextHint = 'What this channel is for'
  end
  object PrivateBox: TCheckBox
    Left = 16
    Height = 28
    Top = 158
    Width = 388
    Align = alTop
    BorderSpacing.Left = 16
    BorderSpacing.Top = 16
    BorderSpacing.Right = 16
    Caption = 'Private (invited members only)'
    TabOrder = 2
  end
  object ButtonPanel1: TButtonPanel
    Left = 16
    Height = 36
    Top = 202
    Width = 388
    Align = alTop
    BorderSpacing.Left = 16
    BorderSpacing.Top = 16
    BorderSpacing.Right = 16
    BorderSpacing.Bottom = 16
    OKButton.Name = 'OKButton'
    OKButton.DefaultCaption = False
    OKButton.Caption = 'Create'
    HelpButton.Name = 'HelpButton'
    HelpButton.DefaultCaption = True
    CloseButton.Name = 'CloseButton'
    CloseButton.DefaultCaption = True
    CancelButton.Name = 'CancelButton'
    CancelButton.DefaultCaption = True
    TabOrder = 3
    ShowButtons = [pbOK, pbCancel]
    ShowBevel = False
    ShowGlyphs = []
