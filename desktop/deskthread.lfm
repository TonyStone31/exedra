  object Replies: TInkMemo
    OnKeyDown = RepliesKeyDown
    Hint = 'Alt+Down or Alt+Up selects a link preview; Enter opens or closes it. Ctrl+Enter opens the link.'
    ShowHint = True
    CodeLineNumbers = True
    Left = 12
    Height = 544
    Top = 52
    Width = 336
    Align = alClient
    BorderSpacing.Left = 12
    BorderSpacing.Right = 12
    BorderSpacing.Bottom = 8
    Color = clWindow
    PopupMenu = MessageMenu
    TabOrder = 1
    WordWrap = True
    OnLinkClick = RepliesLinkClick
    OnResource = RepliesResource
    Borders.Left = 10
    Borders.Top = 3
    Borders.Right = 10
    Borders.Bottom = 3
    StyleSheet.Strings = (
      'p { margin: 2px 0 }'
      '.who { margin-top: 6px }'
      '.at, .edited, .reactions, .replies { color: gray; font-size: smaller }'
      '.badge { color: gray; font-size: x-small; font-weight: bold }'
      '.reactions { margin-top: 4px }'
      '.pill { display: inline-block; border: 1px solid gray; border-radius: 10px; padding: 1px 7px; margin-right: 4px }'
      '.codebar { display: none }'
      'img.shot { max-width: 100%; max-height: 320px; border-radius: 6px }'
      'img.face { width: 22px; height: 22px; vertical-align: middle; border-radius: 11px }'
      '.k { color: #8f3fb6 } .c { color: #6b7686 } .s { color: #1d7d4f } .n { color: #b65a00 } .d { color: #2c63d6 }'
      '@media (prefers-color-scheme: dark) {'
      '  .k { color: #c792ea } .c { color: #6f7d93 } .s { color: #9ccc65 } .n { color: #f7a35c } .d { color: #82aaff }'
      '}'
    )
  end
