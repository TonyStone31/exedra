  object ActionList1: TActionList
    Left = 288
    Top = 88
    object ActSend: TAction
      Caption = 'Send'
      Hint = 'Send the message (Enter)'
      OnExecute = ActSendExecute
    end
    object ActSignOut: TAction
      Caption = 'Sign out'
      Hint = 'Sign out of the server'
      OnExecute = ActSignOutExecute
    end
    object ActQuit: TAction
      Caption = 'Quit'
      Hint = 'Quit Exedra'
      ShortCut = 16465
      OnExecute = ActQuitExecute
    end
    object ActReload: TAction
      Caption = 'Reload'
      Hint = 'Reload rooms and messages (F5)'
      ShortCut = 116
      OnExecute = ActReloadExecute
    end
    object ActPeople: TAction
      AutoCheck = True
      Caption = 'People'
      Checked = True
      Hint = 'Show who is here and who runs the channel (F9)'
      ShortCut = 120
      OnExecute = ActPeopleExecute
    end
    object ActFindHere: TAction
      Caption = 'Find in the messages shown'
      Hint = 'Find words in what is on screen (Ctrl+F)'
      ShortCut = 16454
      OnExecute = ActFindHereExecute
    end
    object ActFind: TAction
      Caption = 'Search the channel''s history...'
      Hint = 'Ask the server for every message in this channel with these words (Ctrl+Shift+F)'
      ShortCut = 24646
      OnExecute = ActFindExecute
    end
    object ActLock: TAction
      Caption = 'Lock this conversation'
      Enabled = False
      Hint = 'End to end: only the two of you can read what is written from now on'
      OnExecute = ActLockExecute
    end
    object ActPins: TAction
      Caption = 'Pinned messages'
      Hint = 'What the channel keeps pinned'
      OnExecute = ActPinsExecute
    end
    object ActSettings: TAction
      Caption = 'Settings...'
      Hint = 'Mail about missed messages, and when to show as away'
      OnExecute = ActSettingsExecute
    end
    object ActAbout: TAction
      Caption = 'About'
      Hint = 'About Exedra'
      OnExecute = ActAboutExecute
    end
  end
