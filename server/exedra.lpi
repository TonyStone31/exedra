        <IsPartOfProject Value="True"/>
      </Unit>
      <Unit>
        <Filename Value="src/core/sitefiles.pas"/>
        <IsPartOfProject Value="True"/>
      </Unit>
      <Unit>
        <Filename Value="src/core/sitescan.pas"/>
        <IsPartOfProject Value="True"/>
      </Unit>
      <Unit>
        <Filename Value="src/chat/chatmessages.pas"/>
        <IsPartOfProject Value="True"/>
      </Unit>
      <Unit>
        <Filename Value="src/chat/chatcommands.pas"/>
        <IsPartOfProject Value="True"/>
