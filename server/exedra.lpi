      </Unit>
      <Unit>
        <Filename Value="src/core/webpages.pas"/>
        <IsPartOfProject Value="True"/>
      </Unit>
    </Units>
  </ProjectOptions>
  <CompilerOptions>
    <Version Value="11"/>
    <Target>
      <Filename Value="bin/exedra"/>
    </Target>
    <SearchPaths>
      <OtherUnitFiles Value="src/core;src/ferret;src/chat;src/wiki;src/forum;src/catalog"/>
      <UnitOutputDirectory Value="lib/server/$(TargetCPU)-$(TargetOS)"/>
    </SearchPaths>
    <CodeGeneration>
