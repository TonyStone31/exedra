[Unit]
Description=Exedra
After=network-online.target
Wants=network-online.target

[Service]
User=exedra
Group=exedra
WorkingDirectory=/opt/exedra
ExecStart=/opt/exedra/exedra /opt/exedra/exedra.ini
Restart=always
RestartSec=2
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
